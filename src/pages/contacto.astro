---
import FilmFrame from "../components/FilmFrame.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getPublishedWorks, getSiteSettings, getWhatsAppUrl, safeExternalUrl } from "../lib/content";

const [settings, works] = await Promise.all([getSiteSettings(), getPublishedWorks()]);
const instagram = safeExternalUrl(settings.instagramUrl);
const whatsapp = getWhatsAppUrl(settings.whatsappNumber);
const contactImage = works[1]?.data.image ?? settings.portrait;
---

<SiteLayout title="Contacto" description="Hablemos de tu idea. Cotiza una sesión de fotos, un videoclip, un evento o un proyecto de diseño con Angel." active="contacto" frame="04 / 036">
  <div class="page-shell contact-layout">
    <section class="contact-copy" aria-labelledby="contact-title">
      <span class="eyebrow">Contacto</span>
      <h1 class="display-heading brush-heading" id="contact-title">Hablemos de tu idea.</h1>
      <p class="lead">Escríbeme por WhatsApp o déjame tu mensaje y te respondo pronto.</p>
      <form class="contact-form" name="contacto" method="POST" action="/gracias/" data-netlify="true" netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="contacto" />
        <div class="honeypot" aria-hidden="true">
          <label for="bot-field">No llenes este campo</label>
          <input id="bot-field" name="bot-field" tabindex="-1" autocomplete="off" />
        </div>
        <label class="field-label" for="nombre">Tu nombre
          <input id="nombre" name="nombre" type="text" autocomplete="name" placeholder="Tu nombre" required />
        </label>
        <label class="field-label" for="contacto-dato">WhatsApp o correo
          <input id="contacto-dato" name="contacto" type="text" autocomplete="email" placeholder="Tu WhatsApp o correo" required />
        </label>
        <label class="field-label" for="necesidad">¿Qué necesitas?
          <input id="necesidad" name="necesidad" type="text" placeholder="Sesión de fotos, evento, videoclip..." required />
        </label>
        <label class="field-label" for="mensaje">Cuéntame tu idea
          <textarea id="mensaje" name="mensaje" placeholder="Cuéntame un poco más sobre tu proyecto" required></textarea>
        </label>
        <button class="button button--red" type="submit"><span class="button__label"><span aria-hidden="true">▶</span> Enviar mensaje</span></button>
      </form>
    </section>

    <aside class="contact-side" aria-label="Otros medios para contactarme">
      <FilmFrame
        class="contact-photo tape"
        image={contactImage}
        alt="Muestra fotográfica de Medellín"
        loading="eager"
        sizes="(max-width: 680px) 100vw, 45vw"
        label="KODAK 400"
        number="52"
      />
      <a class="contact-card" href={whatsapp} target="_blank" rel="noopener noreferrer">
        <span class="contact-card__icon" aria-hidden="true">◉</span>
        <span><h2>WhatsApp</h2><p>La forma más rápida de hablar conmigo</p></span>
        <span class="contact-card__arrow" aria-hidden="true">→</span>
      </a>
      {instagram && (
        <a class="contact-card" href={instagram} target="_blank" rel="noopener noreferrer">
          <span class="contact-card__icon" aria-hidden="true">◎</span>
          <span><h2>Instagram</h2><p>Mira mis trabajos más recientes</p></span>
          <span class="contact-card__arrow" aria-hidden="true">→</span>
        </a>
      )}
      <div class="contact-card">
        <span class="contact-card__icon" aria-hidden="true">⌖</span>
        <span><h2>Medellín, Colombia</h2><p>Trabajo con clientes de todo el país</p></span>
        <span class="contact-card__arrow" aria-hidden="true">→</span>
      </div>
    </aside>
  </div>
</SiteLayout>
