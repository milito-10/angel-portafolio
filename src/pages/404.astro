---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Página no encontrada" description="Este fotograma no existe.">
  <section class="page-shell page-intro not-found" aria-labelledby="not-found-title">
    <div>
      <span class="eyebrow">Error 404 · Fotograma perdido</span>
      <h1 class="display-heading brush-heading" id="not-found-title">Este fotograma no existe.</h1>
      <a class="button button--red" href="/"><span class="button__label">Volver al inicio</span></a>
    </div>
  </section>
</SiteLayout>
