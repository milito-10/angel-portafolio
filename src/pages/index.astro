---
import { Picture } from "astro:assets";
import FilmFrame from "../components/FilmFrame.astro";
import WorkCard from "../components/WorkCard.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getBrandList, getFeaturedWorks, getSiteSettings, getWhatsAppUrl, safeExternalUrl } from "../lib/content";

const [settings, featured, brands] = await Promise.all([
  getSiteSettings(),
  getFeaturedWorks(),
  getBrandList(),
]);
const heroWork = featured[0];
const contactUrl = getWhatsAppUrl(settings.whatsappNumber, "Hola Angel, quiero cotizar un proyecto.");
const titleParts = settings.heroTitle.trim().split(/\s+/);
const heroAccent = titleParts.pop() ?? "";
const heroTitleStart = titleParts.join(" ");
---

<SiteLayout
  title="Fotografía y video"
  description="Fotografía, retratos, videoclips y eventos con una mirada cinematográfica. Angel, fotógrafo y realizador audiovisual de Medellín."
  active="inicio"
  frame="01 / 024"
>
  <div class="page-shell">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__copy">
        <span class="eyebrow">Fotografía y video · Medellín</span>
        <h1 class="hero__title" id="hero-title">
          {heroTitleStart}
          {" "}
          <span>{heroAccent}</span>
        </h1>
        <p class="hero__subtitle">{settings.heroSubtitle}</p>
        <div class="hero__actions">
          <a class="button button--red" href="/trabajos/"><span class="button__label"><span aria-hidden="true">▶</span> Ver trabajos</span></a>
          <a class="button" href="/contacto/">Cotizar un proyecto</a>
        </div>
      </div>
      {heroWork ? (
        <div class="hero__visual tape">
          <span class="hero__scribble" aria-hidden="true"></span>
          <FilmFrame
            class="hero__frame"
            image={heroWork.data.image}
            alt={`Muestra de fotografía: ${heroWork.data.title}`}
            loading="eager"
            fetchpriority="high"
            sizes="(max-width: 680px) calc(100vw - 36px), (max-width: 1244px) 50vw, 590px"
          />
          <div class="hero__caption">
            <span>Último trabajo — {heroWork.data.title}</span>
            <span>CUADRO 024</span>
          </div>
        </div>
      ) : (
        <div class="hero__visual"><div class="hero__frame film-frame"><div class="film-frame__image"></div></div></div>
      )}
    </section>

    <section class="section" aria-labelledby="featured-title">
      <div class="section-heading">
        <h2 class="brush-heading" id="featured-title">Trabajos destacados</h2>
        <a class="text-link" href="/trabajos/">Ver todos <span aria-hidden="true">→</span></a>
      </div>
      <div class="work-grid">
        {featured.length ? featured.map((work, index) => <WorkCard work={work} featured loading={index === 0 ? "eager" : "lazy"} />) : (
          <p class="empty-state">Pronto vas a encontrar aquí una selección de trabajos.</p>
        )}
      </div>
    </section>

    {brands.length > 0 && (
      <section class="section brands" aria-labelledby="brands-title">
        <div class="section-heading">
          <h2 id="brands-title">Marcas con las que he trabajado</h2>
        </div>
        <div class="brands__list">
          {brands.map((brand) => {
            const candidateWidths = [120, 240, 360].filter((width) => width < brand.logo.width);
            const logoWidths = [...candidateWidths, Math.min(360, brand.logo.width)];
            const content = (
              <Picture
                class="brand-logo"
                src={brand.logo}
                alt={brand.name}
                widths={logoWidths}
                sizes="(max-width: 680px) 120px, 150px"
                formats={["avif", "webp"]}
                loading="lazy"
                decoding="async"
              />
            );
            const safeLink = safeExternalUrl(brand.link);
            return safeLink
              ? <a href={safeLink} target="_blank" rel="noopener noreferrer" aria-label={brand.name}>{content}</a>
              : content;
          })}
        </div>
      </section>
    )}

    <section class="section" aria-labelledby="steps-title">
      <div class="section-heading">
        <h2 id="steps-title">Cómo trabajo</h2>
      </div>
      <div class="steps">
        <article class="step">
          <span class="step__number">01</span>
          <p>Me cuentas tu idea: una sesión de fotos, un evento o un videoclip.</p>
        </article>
        <article class="step">
          <span class="step__number">02</span>
          <p>Planeamos juntos el lugar, el estilo y la fecha; hago la sesión o la grabación.</p>
        </article>
        <article class="step">
          <span class="step__number">03</span>
          <p>Edito y te entrego las fotos o el video final en alta calidad.</p>
        </article>
      </div>
    </section>

    <section class="idea-cta" aria-labelledby="cta-title">
      <div class="idea-cta__visual" aria-hidden="true"></div>
      <div class="idea-cta__copy">
        <h2 class="brush-heading" id="cta-title">¿Tienes una idea?</h2>
        <p>Cuéntame qué quieres crear y lo hacemos realidad.</p>
        <div class="idea-cta__actions">
          <a class="button button--red" href={contactUrl} target="_blank" rel="noopener noreferrer"><span class="button__label"><span aria-hidden="true">▶</span> Escríbeme por WhatsApp</span></a>
          <a class="text-link" href="/trabajos/">Ver trabajos</a>
        </div>
      </div>
    </section>
  </div>
</SiteLayout>
