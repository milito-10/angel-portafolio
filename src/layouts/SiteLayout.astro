---
import "@fontsource/oswald/latin-400.css";
import "@fontsource/oswald/latin-500.css";
import "@fontsource/oswald/latin-600.css";
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import oswaldSemiboldFont from "@fontsource/oswald/files/oswald-latin-600-normal.woff2";
import interRegularFont from "@fontsource/inter/files/inter-latin-400-normal.woff2";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  active?: "inicio" | "trabajos" | "sobre-mi" | "contacto";
  frame?: string;
}

const { title, description = "Fotografía, retratos y videoclips hechos en Medellín, Colombia.", active, frame = "01 / 024" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialImage = new URL("/og-image.png", Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#131416" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={`${title} · ANGEL`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · ANGEL`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {active === "inicio" && (
      <>
        <script is:inline>
          if (window.location.pathname === "/" && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            try {
              if (!window.sessionStorage.getItem("angel-intro-seen")) {
                window.sessionStorage.setItem("angel-intro-seen", "true");
                document.documentElement.classList.add("intro-pending");
              }
            } catch (error) {
              console.error("No se pudo comprobar el estado de la introducción cinematográfica.", error);
            }
          }
        </script>
        <style is:inline>
          html.intro-pending {
            overflow: hidden;
          }

          .cinematic-intro {
            position: fixed;
            z-index: 100;
            inset: 0;
            display: none;
            background: #070707;
          }

          html.intro-pending .cinematic-intro {
            display: grid;
          }
        </style>
      </>
    )}
    <link rel="preload" href={oswaldSemiboldFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interRegularFont} as="font" type="font/woff2" crossorigin />
    <title>{title} · ANGEL | Fotografía y video en Medellín</title>
  </head>
  <body>
    {active === "inicio" && (
      <section
        class="cinematic-intro"
        data-cinematic-intro
        role="dialog"
        aria-modal="true"
        aria-labelledby="cinematic-intro-title"
      >
        <div class="cinematic-intro__veil" aria-hidden="true"></div>
        <div class="cinematic-intro__flicker" aria-hidden="true"></div>
        <div class="cinematic-intro__content">
          <div class="cinematic-intro__aperture" aria-hidden="true">
            <img src="/intro-icon.webp" width="96" height="96" alt="" />
          </div>
          <p class="cinematic-intro__name" id="cinematic-intro-title">ANGEL.</p>
          <p class="cinematic-intro__frame">ROLL 01 <span aria-hidden="true">·</span> FRAME 001</p>
        </div>
        <button class="cinematic-intro__skip" type="button">Saltar intro</button>
      </section>
    )}
    <header class="site-header">
      <div class="site-header__inner">
        <a class="wordmark" href="/" aria-label="ANGEL, ir al inicio">ANGEL<span>.</span></a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
          <span class="sr-only">Abrir menú</span>
          <span></span><span></span>
        </button>
        <nav class="primary-nav" id="primary-navigation" aria-label="Navegación principal">
          <a href="/" class:list={{ "is-active": active === "inicio" }} aria-current={active === "inicio" ? "page" : undefined}>Inicio</a>
          <a href="/trabajos/" class:list={{ "is-active": active === "trabajos" }} aria-current={active === "trabajos" ? "page" : undefined}>Trabajos</a>
          <a href="/sobre-mi/" class:list={{ "is-active": active === "sobre-mi" }} aria-current={active === "sobre-mi" ? "page" : undefined}>Sobre mí</a>
          <a href="/contacto/" class:list={{ "is-active": active === "contacto" }} aria-current={active === "contacto" ? "page" : undefined}>Contacto</a>
        </nav>
        <a class="button button--red header-quote" href="/contacto/"><span class="button__label">Cotizar un proyecto</span></a>
      </div>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <p>© 2026 Angel <span aria-hidden="true">·</span> Medellín</p>
        <div class="footer-roll" aria-label={`Rollo ${frame.replace(" / ", ", cuadro ")}`}>
          <span class="barcode" aria-hidden="true"></span>
          <span>ROLL {frame.split(" / ")[0]}</span>
          <span class="footer-roll__slash">/</span>
          <span>FRAME {frame.split(" / ")[1]}</span>
        </div>
        <p class="footer-credit">Sitio hecho por <a href="https://kairo-med.netlify.app" target="_blank" rel="noopener noreferrer">Kairo</a></p>
      </div>
    </footer>
    <script>
      const menuButton = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const navigation = document.querySelector<HTMLElement>("#primary-navigation");
      menuButton?.addEventListener("click", () => {
        const expanded = menuButton.getAttribute("aria-expanded") === "true";
        menuButton.setAttribute("aria-expanded", String(!expanded));
        navigation?.classList.toggle("is-open", !expanded);
      });

      const intro = document.querySelector<HTMLElement>("[data-cinematic-intro]");
      if (intro && document.documentElement.classList.contains("intro-pending")) {
        const skipButton = intro.querySelector<HTMLButtonElement>(".cinematic-intro__skip");
        const pageElements = Array.from(document.body.children).filter(
          (element): element is HTMLElement => element instanceof HTMLElement && element !== intro && element.tagName !== "SCRIPT",
        );
        const previousInertStates = pageElements.map((element) => element.inert);
        pageElements.forEach((element) => {
          element.inert = true;
        });

        let finished = false;
        const finishIntro = () => {
          if (finished) return;
          finished = true;
          window.clearTimeout(introTimeout);
          document.removeEventListener("keydown", handleIntroKeydown);
          document.documentElement.classList.remove("intro-pending");
          document.documentElement.classList.add("intro-closing");
          pageElements.forEach((element, index) => {
            element.inert = previousInertStates[index];
          });
          document.querySelector<HTMLElement>(".hero__title")?.classList.add("hero__title--arrive");
          window.setTimeout(() => {
            document.documentElement.classList.remove("intro-closing");
            intro.remove();
          }, 320);
        };
        const handleIntroKeydown = (event: KeyboardEvent) => {
          if (event.key === "Escape") {
            finishIntro();
          } else if (event.key === "Tab" && skipButton) {
            event.preventDefault();
            skipButton.focus();
          }
        };
        const introTimeout = window.setTimeout(finishIntro, 1100);

        skipButton?.addEventListener("click", finishIntro);
        intro.addEventListener("click", finishIntro);
        document.addEventListener("keydown", handleIntroKeydown);
        skipButton?.focus({ preventScroll: true });
      }
    </script>
  </body>
</html>
