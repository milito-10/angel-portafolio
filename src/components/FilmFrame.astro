---
import FilmImage from "./FilmImage.astro";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  alt: string;
  class?: string;
  label?: string;
  number?: string;
  loading?: "eager" | "lazy";
  sizes?: string;
}

const {
  image,
  alt,
  class: className = "",
  label = "KODAK 400",
  number = "52",
  loading = "lazy",
  sizes,
} = Astro.props;
---

<figure class:list={["film-frame", className]}>
  <div class="film-frame__image">
    <FilmImage image={image} alt={alt} loading={loading} sizes={sizes} />
  </div>
  <span class="film-frame__label" aria-hidden="true">{label}</span>
  <span class="film-frame__number" aria-hidden="true">{number}</span>
  <span class="film-frame__triangle" aria-hidden="true"></span>
</figure>
